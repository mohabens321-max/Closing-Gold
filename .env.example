# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع .env إلى Git أبداً.
ADMIN_TOKEN=Mohabens_123

# التخزين: fs (ملفات محلية، للتجربة أو خادم بقرص دائم) أو s3 (Vercel وغيره)
STORAGE=fs
DATA_DIR=/data

# عند STORAGE=s3 (أي خدمة متوافقة مع S3)
S3_BUCKET=
S3_ENDPOINT=
S3_KEY=
S3_SECRET=
S3_REGION=auto

# أقصى حجم لملف يُرفع بالميغابايت (على Vercel الحد 4.5 فاستعمل 4)
MAX_UPLOAD_MB=24
