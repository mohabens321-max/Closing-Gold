{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "closing": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    },
    "api": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "api" } }
  ]
}
